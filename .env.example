# ============================================================================
# LMS BACKEND - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================================================
# IMPORTANTE:
# 1. Copie este archivo como .env en el mismo directorio
# 2. Reemplace los valores de ejemplo con sus credenciales reales
# 3. NUNCA suba el archivo .env al repositorio
# ============================================================================

# ============================================================================
# AWS S3 CONFIGURATION (REQUERIDO)
# ============================================================================
AWS__AccessKey=AKIA4L3DY2PWXXXXXXXXXX
AWS__SecretKey=YbxEMa92uUoG/T/YviTlJomqYmxxxxxxxxxxxxxxxxx
AWS__Region=us-east-2
AWS__BucketName=lms-s3-storage
AWS__PresignedUrlExpirationMinutes=15
AWS__MaxFileSizeBytes=52428800

# ============================================================================
# SMTP CONFIGURATION (Brevo)
# ============================================================================
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__Username=your-brevo-username
Smtp__Password=your-brevo-password
Smtp__From=your-email@example.com

# ============================================================================
# SENDGRID CONFIGURATION (Alternativa a SMTP)
# ============================================================================
SendGrid__ApiKey=SG.your-sendgrid-api-key
SendGrid__From=your-email@example.com
SendGrid__FromName=LMS Sistema

# ============================================================================
# GOOGLE DRIVE CONFIGURATION
# ============================================================================
GoogleDrive__FolderId=your-google-drive-folder-id

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
Jwt__Key=1234567890ABCDEF1234567890ABCDEF
Jwt__Issuer=LMSBackend
Jwt__Audience=LMSBackendClient

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=lmsdb;Username=postgres;Password=your-password

# ============================================================================
# 3DLAB CONFIGURATION
# ============================================================================
ThreeDLab__ApiKey=3DLAB-SECRET-KEY-CHANGE-IN-PRODUCTION
ThreeDLab__ServiceUserEmail=3dlab@laboratorio.edu
ThreeDLab__ServiceUserPassword=3DLab@2025!Secure
ThreeDLab__ServiceUserName=Integración 3DLAB
ThreeDLab__ServiceUserRut=99999999-9
ThreeDLab__ServiceUserRole=Alumno

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
Storage__Path=wwwroot/uploads

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
#
# 1. AWS S3:
#    - Use un usuario IAM con permisos mínimos
#    - Configure Block Public Access en el bucket
#    - Habilite encriptación en reposo (AES256)
#    - Habilite versionado y logging
#
# 2. JWT:
#    - Use una clave de al menos 32 caracteres
#    - Genere una clave aleatoria: openssl rand -base64 32
#    - Cambie la clave en producción
#
# 3. Database:
#    - Use contraseñas fuertes
#    - Restrinja acceso por IP
#    - Habilite SSL/TLS en conexiones
#
# 4. SMTP/SendGrid:
#    - Use credenciales de aplicación (no personales)
#    - Limite permisos a solo envío de emails
#
# ============================================================================
