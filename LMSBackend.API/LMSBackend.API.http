# Banco de Preguntas - Crear Pregunta Manual
POST {{LMSBackend.API_HostAddress}}/api/BancoPreguntas
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

{
  "enunciado": "¿Cuál es la capital de Chile?",
  "tipo": "SeleccionMultiple",
  "puntaje": 1,
  "evaluacionId": 1,
  "opciones": [
    {
      "texto": "Santiago",
      "esCorrecta": true,
      "orden": 1
    },
    {
      "texto": "Buenos Aires",
      "esCorrecta": false,
      "orden": 2
    },
    {
      "texto": "Lima",
      "esCorrecta": false,
      "orden": 3
    }
  ]
}

